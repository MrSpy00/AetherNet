# AetherNet Environment Configuration Example
# Copy this file to .env and fill in your keys if using AI modules

# DeepSeek API Key (Default AI Provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI API Key (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Ollama Local Host

OLLAMA_HOST=http://localhost:11434

# Security / Encrypted storage key (optional override)
AETHERNET_MASTER_KEY=
